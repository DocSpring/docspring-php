{
    "name": "docspring/docspring",
    "version": "4.3.0",
    "description": "Use DocSpring's API to fill PDF forms, generate PDFs and Word documents from HTML or Word templates, merge PDFs, and request legally binding e-signatures.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/DocSpring/docspring-php",
    "license": "MIT",
    "authors": [
        {
            "name": "DocSpring",
            "homepage": "https://docspring.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": { "DocSpring\\" : "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "DocSpring\\Test\\" : "test/" }
    }
}
